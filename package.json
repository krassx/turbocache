{
  "name": "turbocache",
  "version": "0.1.0",
  "description": "Layered in-memory KV cache for Node.js clusters: per-process L1 with a byte budget over a shared-memory L2 the primary owns and workers map read-only.",
  "license": "MIT",
  "author": "Alexey Karimov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krassx/turbocache.git"
  },
  "homepage": "https://github.com/krassx/turbocache#readme",
  "bugs": {
    "url": "https://github.com/krassx/turbocache/issues"
  },
  "keywords": [
    "cache",
    "shared-memory",
    "cluster",
    "ipc",
    "lru",
    "native",
    "napi"
  ],
  "type": "commonjs",
  "main": "./prototype/turbocache.js",
  "module": "./prototype/index.mjs",
  "types": "./prototype/index.d.ts",
  "exports": {
    ".": {
      "types": "./prototype/index.d.ts",
      "import": "./prototype/index.mjs",
      "require": "./prototype/turbocache.js",
      "default": "./prototype/turbocache.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "prototype/turbocache.js",
    "prototype/index.mjs",
    "prototype/index.d.ts",
    "prototype/binding.cc",
    "prototype/store.h",
    "prototype/store_ops.h",
    "prototype/submit.h",
    "prototype/platform.h",
    "prototype/vendor/",
    "prototype/binding.gyp",
    "prototype/find_lz4.js",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "gypfile": true,
  "scripts": {
    "install": "node-gyp rebuild --directory=prototype",
    "build": "node-gyp rebuild --directory=prototype",
    "test": "node scripts/test.js"
  },
  "devDependencies": {
    "node-gyp": "^10.0.0",
    "typescript": "^5.4.0"
  }
}
